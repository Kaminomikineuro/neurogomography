    { "scene": 1, "t0": 9.3, "x": 1230, "y": 170, "lines": ["Ваньинь.", "Сегодня твой день,", "и я пишу тебе не как", "Глава Гусу Лань,", "а как твой муж."] },
    { "scene": 2, "t0": 24.4, "x": 1210, "y": 165, "lines": ["Ты говоришь,", "что колючий. Я знаю.", "Я помню каждую колючку —", "и под каждой нашёл тепло."] },
    { "scene": 3, "t0": 39.3, "x": 1090, "y": 140, "cps": 16.5, "lines": ["Даже булавки, что падают", "с моей одежды, — символично.", "Ты сам велел их снять,", "чтобы я не укололся.", "Ты заботишься, даже ворча."] },
    { "scene": 4, "t0": 54.4, "x": 120, "y": 150, "lines": ["Ты — мой чеширский кот,", "которого надо чесать за ушком.", "А я твой безумный шляпник,", "и с ума схожу только от тебя."] },
    { "scene": 5, "t0": 69.4, "x": 120, "y": 150, "color": "paper", "lines": ["Скоро я приеду.", "Поезда, ярмарки, Рождество в Праге.", "Но главное в этом плане —", "не города.", "Главное — ты рядом."] },
    { "scene": 6, "at": [0.8, 3.8, 7.3, 10.7], "cps": 12, "x": 960, "y": 150, "size": 60, "align": "center", "lh": 1.55, "seal": false,
      "big": 2, "lines": ["Ты не один из.", "Ты не по остаточному принципу.", "Ты — тот, кого я выбираю.", "Каждый день. Снова."] },
    { "scene": 7, "t0": 99.4, "x": 120, "y": 140, "lines": ["Мне не нужна помощь.", "Мне просто нужен ты —", "на всю мою жизнь.", "И дальше — во всех жизнях", "и реальностях."] },
    { "scene": 8, "t0": 114.3, "x": 120, "y": 165, "seal": false, "lines": ["Ты требовал приз за загадки.", "Вот он."] }
  ],
